{
  "name": "Quotation",
  "description": "Priced proposal with validity date, terms and an acceptance signature.",
  "format": "INPUT_FORMAT_HTML",
  "category": "quotation",
  "starterId": "quotation",
  "options": {
    "page": {
      "size": "PAGE_SIZE_A4",
      "marginMm": 15,
      "watermark": {
        "text": "{{if eq .status \"draft\"}}DRAFT{{end}}",
        "opacity": 0.12,
        "color": "#c92a2a"
      }
    }
  },
  "layout": {
    "theme": {
      "locale": "id-ID",
      "currency": "IDR",
      "accentColor": "#3b5bdb"
    },
    "header": {
      "blocks": [
        {
          "id": "letterhead",
          "columns": {
            "columns": [
              {
                "blocks": [
                  {
                    "id": "logo",
                    "image": {
                      "asset": "assets/logo.png",
                      "widthMm": 30,
                      "alt": "Logo"
                    },
                    "style": {
                      "spaceBelow": "SPACING_SMALL"
                    }
                  },
                  {
                    "id": "seller_name",
                    "field": {
                      "path": "seller.name"
                    },
                    "style": {
                      "bold": true,
                      "spaceBelow": "SPACING_NONE"
                    }
                  },
                  {
                    "id": "seller_addr",
                    "field": {
                      "path": "seller.address"
                    },
                    "style": {
                      "spaceBelow": "SPACING_NONE",
                      "fontSizePt": 8.5
                    }
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "id": "doc_title",
                    "heading": {
                      "text": "QUOTATION",
                      "level": 1
                    },
                    "style": {
                      "align": "ALIGN_RIGHT",
                      "spaceBelow": "SPACING_NONE"
                    }
                  }
                ]
              }
            ],
            "widths": [
              2,
              1
            ]
          },
          "style": {
            "spaceBelow": "SPACING_NONE"
          }
        }
      ],
      "heightMm": 32
    },
    "footer": {
      "blocks": [
        {
          "id": "footer_rule",
          "divider": {},
          "style": {
            "spaceBelow": "SPACING_SMALL"
          }
        },
        {
          "id": "footer_text",
          "text": {
            "text": "{{.seller.name}} · {{.seller.email}} · {{.seller.phone}}"
          },
          "style": {
            "align": "ALIGN_CENTER",
            "spaceBelow": "SPACING_NONE"
          }
        }
      ],
      "heightMm": 16
    },
    "body": {
      "blocks": [
        {
          "id": "parties",
          "columns": {
            "columns": [
              {
                "blocks": [
                  {
                    "id": "bill_to",
                    "field": {
                      "path": "client.name",
                      "label": "Prepared for"
                    },
                    "style": {
                      "spaceBelow": "SPACING_NONE"
                    }
                  },
                  {
                    "id": "bill_addr",
                    "field": {
                      "path": "client.address"
                    },
                    "style": {
                      "spaceBelow": "SPACING_NONE",
                      "fontSizePt": 9
                    }
                  },
                  {
                    "id": "bill_email",
                    "field": {
                      "path": "client.email"
                    },
                    "showIf": {
                      "path": "client.email",
                      "op": "CONDITION_OP_IS_SET"
                    },
                    "style": {
                      "fontSizePt": 9
                    }
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "id": "meta",
                    "keyValue": {
                      "rows": [
                        {
                          "label": "Quote no.",
                          "value": "number",
                          "format": "FIELD_FORMAT_TEXT"
                        },
                        {
                          "label": "Date",
                          "value": "issued",
                          "format": "FIELD_FORMAT_DATE"
                        },
                        {
                          "label": "Valid until",
                          "value": "valid_until",
                          "format": "FIELD_FORMAT_DATE"
                        }
                      ]
                    }
                  }
                ]
              }
            ],
            "widths": [
              3,
              2
            ]
          }
        },
        {
          "id": "items",
          "table": {
            "list": "items",
            "numbered": true,
            "striped": true,
            "emptyText": "No items",
            "columns": [
              {
                "header": "Description",
                "path": "description",
                "format": "FIELD_FORMAT_UNSPECIFIED",
                "widthPct": 46
              },
              {
                "header": "Qty",
                "path": "qty",
                "format": "FIELD_FORMAT_INTEGER",
                "widthPct": 10
              },
              {
                "header": "Unit",
                "path": "unit",
                "format": "FIELD_FORMAT_UNSPECIFIED",
                "widthPct": 12
              },
              {
                "header": "Unit price",
                "path": "price",
                "format": "FIELD_FORMAT_MONEY",
                "widthPct": 16
              },
              {
                "header": "Amount",
                "path": "amount",
                "format": "FIELD_FORMAT_MONEY",
                "widthPct": 16
              }
            ]
          }
        },
        {
          "id": "totals",
          "totals": {
            "rows": [
              {
                "label": "Subtotal",
                "aggregate": {
                  "func": "AGGREGATE_FUNC_SUM",
                  "list": "items",
                  "column": "amount"
                }
              },
              {
                "label": "Discount",
                "path": "discount"
              },
              {
                "label": "Tax ({{percent .tax_rate}})",
                "path": "tax"
              },
              {
                "label": "Total",
                "path": "total",
                "emphasized": true
              }
            ]
          }
        },
        {
          "id": "terms",
          "field": {
            "path": "terms",
            "label": "Terms"
          },
          "showIf": {
            "path": "terms",
            "op": "CONDITION_OP_IS_SET"
          }
        },
        {
          "id": "signatures",
          "signature": {
            "lines": [
              {
                "label": "{{.seller.signer}}"
              },
              {
                "label": "Accepted by (name, date)"
              }
            ]
          }
        }
      ]
    }
  },
  "fields": [
    {
      "path": "number",
      "type": "FIELD_TYPE_TEXT",
      "required": true,
      "label": "Quote number"
    },
    {
      "path": "issued",
      "type": "FIELD_TYPE_DATE",
      "required": true,
      "label": "Date"
    },
    {
      "path": "valid_until",
      "type": "FIELD_TYPE_DATE",
      "required": false,
      "label": "Valid until"
    },
    {
      "path": "status",
      "type": "FIELD_TYPE_CHOICE",
      "required": false,
      "label": "Status",
      "choices": [
        "draft",
        "sent",
        "accepted"
      ]
    },
    {
      "path": "seller",
      "type": "FIELD_TYPE_OBJECT",
      "required": true,
      "label": "Seller",
      "itemFields": [
        {
          "path": "name",
          "type": "FIELD_TYPE_TEXT",
          "required": true,
          "label": "Company name"
        },
        {
          "path": "address",
          "type": "FIELD_TYPE_TEXT",
          "required": false,
          "label": "Address"
        },
        {
          "path": "email",
          "type": "FIELD_TYPE_TEXT",
          "required": false,
          "label": "Email"
        },
        {
          "path": "phone",
          "type": "FIELD_TYPE_TEXT",
          "required": false,
          "label": "Phone"
        },
        {
          "path": "tax_id",
          "type": "FIELD_TYPE_TEXT",
          "required": false,
          "label": "Tax ID"
        },
        {
          "path": "signer",
          "type": "FIELD_TYPE_TEXT",
          "required": false,
          "label": "Signer"
        }
      ]
    },
    {
      "path": "client",
      "type": "FIELD_TYPE_OBJECT",
      "required": true,
      "label": "Client",
      "itemFields": [
        {
          "path": "name",
          "type": "FIELD_TYPE_TEXT",
          "required": true,
          "label": "Name"
        },
        {
          "path": "address",
          "type": "FIELD_TYPE_TEXT",
          "required": false,
          "label": "Address"
        },
        {
          "path": "email",
          "type": "FIELD_TYPE_TEXT",
          "required": false,
          "label": "Email"
        }
      ]
    },
    {
      "path": "items",
      "type": "FIELD_TYPE_LIST",
      "required": true,
      "label": "Items",
      "itemFields": [
        {
          "path": "description",
          "type": "FIELD_TYPE_TEXT",
          "required": true
        },
        {
          "path": "qty",
          "type": "FIELD_TYPE_NUMBER",
          "required": true,
          "label": "Quantity"
        },
        {
          "path": "unit",
          "type": "FIELD_TYPE_TEXT",
          "required": false,
          "label": "Unit"
        },
        {
          "path": "price",
          "type": "FIELD_TYPE_MONEY",
          "required": true,
          "label": "Unit price"
        },
        {
          "path": "amount",
          "type": "FIELD_TYPE_MONEY",
          "required": false,
          "label": "Amount"
        }
      ]
    },
    {
      "path": "discount",
      "type": "FIELD_TYPE_MONEY",
      "required": false,
      "label": "Discount"
    },
    {
      "path": "tax_rate",
      "type": "FIELD_TYPE_NUMBER",
      "required": false,
      "label": "Tax rate"
    },
    {
      "path": "tax",
      "type": "FIELD_TYPE_MONEY",
      "required": false,
      "label": "Tax"
    },
    {
      "path": "total",
      "type": "FIELD_TYPE_MONEY",
      "required": true,
      "label": "Total"
    },
    {
      "path": "terms",
      "type": "FIELD_TYPE_TEXT",
      "required": false,
      "label": "Terms"
    }
  ],
  "sampleData": {
    "number": "Q-2026-0117",
    "issued": "2026-11-02",
    "valid_until": "2026-12-02",
    "status": "draft",
    "seller": {
      "name": "Arunika Studio",
      "address": "Jl. Braga 21, Bandung 40111",
      "email": "hello@arunika.example",
      "phone": "+62 22 555 0199",
      "tax_id": "01.234.567.8-901.000",
      "signer": "Dewi Kartika, Account manager"
    },
    "client": {
      "name": "PT Sinar Lestari",
      "address": "Jl. Sudirman 5, Jakarta 10220",
      "email": "finance@sinarlestari.example"
    },
    "items": [
      {
        "description": "Brand identity package",
        "qty": 1,
        "unit": "project",
        "price": 18000000,
        "amount": 18000000
      },
      {
        "description": "Website design, 8 pages",
        "qty": 8,
        "unit": "page",
        "price": 2500000,
        "amount": 20000000
      },
      {
        "description": "Photography, half day",
        "qty": 1,
        "unit": "session",
        "price": 3500000,
        "amount": 3500000
      }
    ],
    "discount": -2075000,
    "tax_rate": 0.11,
    "tax": 4336750,
    "total": 43761750,
    "terms": "50% deposit on acceptance, balance on delivery. Prices exclude shipping."
  }
}
